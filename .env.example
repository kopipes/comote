# Comote listens on loopback. Tailscale Serve is the public-facing HTTPS layer.
COMOTE_HOST=127.0.0.1
COMOTE_PORT=4173
COMOTE_DATA_DIR=/home/coder/.local/share/comote
COMOTE_PROJECTS_ROOT=/home/coder/projects
COMOTE_PASSWORD_HASH=scrypt$replace-with-output-from-npm-run-password-hash
COMOTE_COOKIE_SECURE=true
COMOTE_CODEX_BIN=/usr/local/bin/codex
COMOTE_PREVIEW_PORT=4180
COMOTE_PREVIEW_URL=https://comote-vps.example.ts.net:8443
COMOTE_DEPLOY_DOMAIN=apps.example.com
COMOTE_DEPLOY_SOCKET=/run/comote-deploy.sock
COMOTE_SESSION_DAYS=30
COMOTE_IDLE_MINUTES=30
