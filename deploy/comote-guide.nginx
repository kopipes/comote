server {
    listen 10.0.3.25:80;
    server_name guide.apps.devop.my.id;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 10.0.3.25:443 ssl http2;
    server_name guide.apps.devop.my.id;

    ssl_certificate /etc/letsencrypt/live/guide.apps.devop.my.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/guide.apps.devop.my.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    root /opt/comote/current/guide;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location / {
        try_files $uri $uri/ =404;
    }
}
