[Unit]
Description=Comote secure coding workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coder
Group=coder
WorkingDirectory=/opt/comote/current
EnvironmentFile=/etc/comote/comote.env
ExecStart=/usr/bin/node build/server/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

NoNewPrivileges=true
UMask=0077
RemoveIPC=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/home/coder/.local/share/comote /home/coder/.codex /home/coder/projects

[Install]
WantedBy=multi-user.target
